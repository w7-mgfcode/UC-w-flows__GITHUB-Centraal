# Copy this file to `.env` for local development.
# Never commit real secrets.

# --- AI Review / Bots (GitHub Actions) ---
# Required for `.github/workflows/copilot-review.yml` (CodeRabbit)
OPENAI_API_KEY=

# Optional for `.github/workflows/copilot-review.yml` (Sourcery)
SOURCERY_TOKEN=

# Optional: Codecov upload token (usually only needed for private repos)
CODECOV_TOKEN=

# --- Pipeline MCP server (local) ---
# Used by `pipeline-mcp/` to call GitHub Actions APIs.
# Prefer a fine-scoped token (PAT) with only the permissions you need.
GITHUB_TOKEN=

# Optional defaults so tool calls can omit owner/repo.
GITHUB_OWNER=
GITHUB_REPO=

# Optional: override GitHub API base URL (useful for GitHub Enterprise)
GITHUB_API_BASE_URL=

# Optional
MCP_USER_AGENT=pipeline-mcp/0.1.0

# --- Notes ---
# GitHub Actions provides GITHUB_TOKEN automatically; do NOT set it here.
